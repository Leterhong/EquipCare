# =====================================================================
# 巡维云 EquipCare · 前端镜像（Nginx 静态托管 + API 反向代理）
# 构建上下文 = equipcare-server/ 目录：
#   docker build -f Dockerfile.frontend -t equipcare/frontend:latest .
# 前端为原生 ES Module 单页应用，无构建步骤，直接拷贝静态资源。
# =====================================================================

FROM nginx:1.27-alpine

ENV TZ=Asia/Shanghai

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY equipcare-admin/src/main/resources/static/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/ || exit 1
