# =====================================================================
# 巡维云 EquipCare · 环境变量样例
# 用法：cp deploy/env.example .env 后逐项修改；.env 含敏感信息，禁止提交仓库。
# 强密码建议：openssl rand -base64 24 生成（避免 $ ` \ 引号等 shell 特殊字符）。
# =====================================================================

# ---------- MySQL ----------
# root 口令（仅容器内部初始化与本机管理用，应用不使用 root 连接）
MYSQL_ROOT_PASSWORD=请替换为root强密码

# 应用数据库账号 equipcare_app 的口令（后端连接使用）
EQUIPCARE_APP_PASSWORD=请替换为应用账号强密码

# ---------- Redis ----------
REDIS_PASSWORD=请替换为Redis强密码

# ---------- 应用安全 ----------
# JWT 签名密钥：至少 32 字节，HS256；上线前必须更换，泄漏等同于账号体系沦陷
# 生产 profile 下未注入或使用开发默认值将拒绝启动（ProdSecurityGuard 强校验）
EQUIPCARE_JWT_SECRET=请替换为至少32字节的随机密钥例如 openssl-rand-base64-48

# Spring Profile：docker-compose 已注入 SPRING_PROFILES_ACTIVE=prod（启用敏感配置强校验、
# 关闭 SQL 打印与 Swagger）。本地开发无需设置，默认 dev。

# ---------- 对外访问 ----------
# 前端对外端口（默认 80）
FRONTEND_PORT=80
# 扫码落地页基址：手机扫码可达的地址，如 http://192.168.1.100 或 https://equipcare.example.com
EQUIPCARE_SCAN_BASE_URL=

# ---------- 首次部署管理员引导（创建成功后必须改回 false 并重启） ----------
EQUIPCARE_BOOTSTRAP_ENABLED=false
EQUIPCARE_BOOTSTRAP_USERNAME=admin
EQUIPCARE_BOOTSTRAP_PASSWORD=
EQUIPCARE_BOOTSTRAP_REAL_NAME=系统管理员

# ---------- 创新升级（第八期）：事件驱动 / SSE / AI 副驾 ----------
# 领域事件发件箱与 SSE 实时推送（默认开启，无需修改）
# EQUIPCARE_OUTBOX_ENABLED=true
# EQUIPCARE_SSE_ENABLED=true

# AI 智能副驾：OpenAI 兼容协议，任选一家。不配置则 AI 功能整体隐藏，系统不受影响
# 火山方舟示例（把 Key 换成你的，模型 ID 需带版本号如 doubao-seed-1-6-251015）：
# EQUIPCARE_AI_ENABLED=true
# EQUIPCARE_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# EQUIPCARE_AI_API_KEY=
# EQUIPCARE_AI_MODEL=
# 智谱：EQUIPCARE_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4  EQUIPCARE_AI_MODEL=glm-4.7
# DeepSeek：EQUIPCARE_AI_BASE_URL=https://api.deepseek.com/v1  EQUIPCARE_AI_MODEL=deepseek-chat
# AI 深化（可选）：缺陷识别视觉模型 / 维修知识库 RAG 嵌入模型
# EQUIPCARE_AI_VISION_MODEL=doubao-seed-1-6-251015
# EQUIPCARE_AI_EMBEDDING_MODEL=doubao-embedding-text-240515
# EQUIPCARE_AI_KB_ENABLED=true

# CORS 允许来源（生产建议收敛为前端域名）
# EQUIPCARE_CORS_ALLOWED_ORIGINS=https://equip.example.com
# 多租户（单租户部署保持默认 true；租户管理仅 ADMIN 可见）
# EQUIPCARE_MULTI_TENANT_ENABLED=true

# ---------- 通知外发（第九期，可选，默认关闭） ----------
# 企业微信群机器人 webhook（群设置 → 群机器人 → 添加后复制 webhook 地址）
# EQUIPCARE_NOTIFY_WECOM_WEBHOOK_URL=
# 安全告警收件邮箱（账号锁定等事件；配合下方 SMTP）
# EQUIPCARE_NOTIFY_SECURITY_EMAIL=admin@example.com
# SMTP 邮件（事件通知发给相关用户的企业邮箱）
# EQUIPCARE_NOTIFY_MAIL_ENABLED=true
# EQUIPCARE_NOTIFY_MAIL_HOST=smtp.example.com
# EQUIPCARE_NOTIFY_MAIL_PORT=465
# EQUIPCARE_NOTIFY_MAIL_USERNAME=alarm@example.com
# EQUIPCARE_NOTIFY_MAIL_PASSWORD=
# EQUIPCARE_NOTIFY_MAIL_FROM=alarm@example.com
