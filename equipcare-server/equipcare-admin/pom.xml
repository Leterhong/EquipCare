<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.equipcare</groupId>
        <artifactId>equipcare-server</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>equipcare-admin</artifactId>
    <name>equipcare-admin</name>
    <description>启动打包：主类、初始化引导(bootstrap)、application 配置、静态前端、集成测试</description>

    <dependencies>
        <dependency>
            <groupId>com.equipcare</groupId>
            <artifactId>equipcare-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.equipcare</groupId>
            <artifactId>equipcare-business</artifactId>
        </dependency>
        <dependency>
            <groupId>com.equipcare</groupId>
            <artifactId>equipcare-ai</artifactId>
        </dependency>

        <!-- 监控（/actuator/health 供 Docker/Nginx 健康检查） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok（AdminBootstrapRunner 使用） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 测试：单元 + 集成（IT 依赖真实 MySQL/Redis） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 架构守护测试：模块依赖方向作为可执行规则固定下来 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>equipcare-server</finalName>
        <plugins>
            <!-- 可执行 fat jar；start-class 显式指定，避免多模块下自动探测失败 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.equipcare.EquipCareApplication</mainClass>
                </configuration>
            </plugin>

            <!-- 把 database/*.sql 打入 classpath:/db/，保证 SQL 只有一份来源。
                 database/ 位于父工程根目录，用 multiModuleProjectDirectory 定位 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-database-scripts</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/db</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}/database</directory>
                                    <includes>
                                        <include>*.sql</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 集成测试（依赖真实 MySQL/Redis）：mvn verify -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
